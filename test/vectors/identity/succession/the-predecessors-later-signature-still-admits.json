{
  "note": "§0: a Succession is not a revocation of the predecessor. Its later acts are valid and the verifier prints them as post-succession — deciding what they mean is the reader's.",
  "kind": {
    "group": "vectors.r5e.io",
    "kind": "Note",
    "version": "v1alpha1",
    "substrate": "resource",
    "naming": {
      "mode": "caller"
    },
    "description": "A one-field resource, so an authority vector has something harmless to admit.",
    "schema": {
      "required": [
        "body"
      ],
      "properties": {
        "body": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "predicates": []
  },
  "setup": [
    {
      "kind": "core.r5e.io/v1/Succession",
      "sign": [
        1,
        2
      ],
      "spec": {
        "predecessor": "$key.1",
        "successor": "$key.2",
        "successorKey": {
          "algorithm": "ed25519",
          "bytes": "$key.2.bytes"
        }
      }
    }
  ],
  "instance": {
    "name": "a1",
    "sign": [
      1
    ],
    "spec": {
      "body": "still me"
    }
  },
  "expect": {
    "outcome": "admitted",
    "name": "a1"
  }
}
