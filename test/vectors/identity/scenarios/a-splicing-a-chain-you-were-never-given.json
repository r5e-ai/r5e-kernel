{
  "note": "Walk scenario (a). Root endorses Alice, with the right to issue. Mallory issues to Carol and names Root→Alice as the parent — every *other* effectiveness predicate passes and the walk reaches Root. §5's `parent.subject == issuer` is the whole of what stops a stranger inheriting a chain by pointing at it, and here it is asked before the walk ever runs: Mallory cannot even cite the parent, because its subject is Alice.\n\nThen the honest version of the same act: Alice issues to Carol, citing the parent she actually holds, and Carol's act resolves to Root.",
  "kind": {
    "group": "vectors.r5e.io",
    "kind": "Note",
    "version": "v1alpha1",
    "substrate": "resource",
    "naming": {
      "mode": "caller"
    },
    "description": "A one-field resource, so an authority vector has something harmless to admit.",
    "schema": {
      "required": [
        "body"
      ],
      "properties": {
        "body": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "predicates": []
  },
  "setup": [
    {
      "kind": "core.r5e.io/v1/Endorsement",
      "sign": [
        1
      ],
      "spec": {
        "subject": "$key.2",
        "subjectKey": {
          "algorithm": "ed25519",
          "bytes": "$key.2.bytes"
        },
        "kinds": [
          "*"
        ],
        "mayIssue": true,
        "notBefore": "2020-01-01T00:00:00Z",
        "notAfter": "2099-01-01T00:00:00Z",
        "role": "root"
      }
    },
    {
      "kind": "core.r5e.io/v1/Endorsement",
      "sign": [
        2
      ],
      "spec": {
        "subject": "$key.3",
        "subjectKey": {
          "algorithm": "ed25519",
          "bytes": "$key.3.bytes"
        },
        "kinds": [
          "*"
        ],
        "mayIssue": false,
        "notBefore": "2020-01-01T00:00:00Z",
        "notAfter": "2099-01-01T00:00:00Z",
        "role": "worker",
        "parent": {
          "$ref": "$setup.0.eventRef"
        }
      },
      "authority": [
        "$setup.0.eventRef"
      ]
    }
  ],
  "instance": {
    "name": "a1",
    "sign": [
      3
    ],
    "spec": {
      "body": "under authority"
    },
    "authority": [
      "$setup.1.eventRef"
    ]
  },
  "expect": {
    "outcome": "admitted",
    "name": "a1",
    "authorityRoots": [
      "$key.1"
    ]
  }
}
