{
  "note": "§4: and a key that is not on the path is refused — succession widens who may supersede, it does not open it.",
  "kind": {
    "group": "vectors.r5e.io",
    "kind": "Succeedable",
    "version": "v1alpha1",
    "substrate": "resource",
    "naming": {
      "mode": "caller",
      "readmitBy": "actorOfRecordOrSuccessor"
    },
    "description": "A caller-named resource only its actor of record, or a successor, may supersede.",
    "schema": {
      "required": [
        "body"
      ],
      "properties": {
        "body": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "predicates": []
  },
  "setup": [
    {
      "name": "r1",
      "sign": [
        1
      ],
      "spec": {
        "body": "first"
      }
    },
    {
      "kind": "core.r5e.io/v1/Succession",
      "sign": [
        1,
        2
      ],
      "spec": {
        "predecessor": "$key.1",
        "successor": "$key.2",
        "successorKey": {
          "algorithm": "ed25519",
          "bytes": "$key.2.bytes"
        }
      }
    }
  ],
  "instance": {
    "name": "r1",
    "sign": [
      4
    ],
    "spec": {
      "body": "second"
    }
  },
  "expect": {
    "outcome": "denied",
    "stage": "validateStructure",
    "reasonIncludes": "readmitBy: actorOfRecordOrSuccessor"
  }
}
