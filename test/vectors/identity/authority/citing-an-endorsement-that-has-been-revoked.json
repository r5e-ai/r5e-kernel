{
  "note": "§5 clause 3: revoked by the actor that made it, so it is withdrawn. The reason names the Revocation's seq — a reader can go and look at the act that did it.",
  "kind": {
    "group": "vectors.r5e.io",
    "kind": "Note",
    "version": "v1alpha1",
    "substrate": "resource",
    "naming": {
      "mode": "caller"
    },
    "description": "A one-field resource, so an authority vector has something harmless to admit.",
    "schema": {
      "required": [
        "body"
      ],
      "properties": {
        "body": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "predicates": []
  },
  "setup": [
    {
      "kind": "core.r5e.io/v1/Endorsement",
      "sign": [
        1
      ],
      "spec": {
        "subject": "$key.2",
        "subjectKey": {
          "algorithm": "ed25519",
          "bytes": "$key.2.bytes"
        },
        "kinds": [
          "*"
        ],
        "mayIssue": true,
        "notBefore": "2020-01-01T00:00:00Z",
        "notAfter": "2099-01-01T00:00:00Z"
      }
    },
    {
      "kind": "core.r5e.io/v1/Revocation",
      "sign": [
        1
      ],
      "spec": {
        "revokes": {
          "$ref": "$setup.0.eventRef"
        }
      }
    }
  ],
  "instance": {
    "name": "a1",
    "sign": [
      2
    ],
    "spec": {
      "body": "under authority"
    },
    "authority": [
      "$setup.0.eventRef"
    ]
  },
  "expect": {
    "outcome": "denied",
    "stage": "resolve",
    "reasonIncludes": "authority ineffective: revoked at"
  }
}
