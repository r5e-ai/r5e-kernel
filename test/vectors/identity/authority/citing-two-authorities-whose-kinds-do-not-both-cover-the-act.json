    "kind": "Note",
    "version": "v1alpha1",
    "substrate": "resource",
    "naming": {
      "mode": "caller"
    },
    "description": "A one-field resource, so an authority vector has something harmless to admit.",
    "schema": {
      "required": [
        "body"
      ],
      "properties": {
        "body": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "predicates": []
  },
  "setup": [
    {
      "kind": "core.r5e.io/v1/Endorsement",
      "sign": [
        1
      ],
      "spec": {
        "subject": "$key.2",
        "subjectKey": {
          "algorithm": "ed25519",
          "bytes": "$key.2.bytes"
        },
        "kinds": [
          "vectors.r5e.io/v1alpha1/Note"
        ],
        "mayIssue": true,
        "notBefore": "2020-01-01T00:00:00Z",
        "notAfter": "2099-01-01T00:00:00Z"
      }
    },
    {
      "kind": "core.r5e.io/v1/Endorsement",
      "sign": [
        3
      ],
      "spec": {
        "subject": "$key.2",
        "subjectKey": {
          "algorithm": "ed25519",
          "bytes": "$key.2.bytes"
        },
        "kinds": [
          "vectors.r5e.io/v1alpha1/Other"
        ],
        "mayIssue": true,
        "notBefore": "2020-01-01T00:00:00Z",
        "notAfter": "2099-01-01T00:00:00Z"
      }
    }
  ],
  "instance": {
    "name": "a1",
    "sign": [
      2
    ],
    "spec": {
      "body": "under authority"
    },
    "authority": [
      "$setup.0.eventRef",
      "$setup.1.eventRef"
    ]
  },
  "expect": {
    "outcome": "denied",
    "stage": "resolve",
    "reasonIncludes": "kind outside authority"
  }
