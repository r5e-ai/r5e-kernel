{
  "note": "§9: pins never follow succession. The root of this chain is the node key, and the node key is then succeeded on the very bundle being read — so a reader who pinned the root has *not* thereby pinned its successor, and the report says so in the contract's own words. The direction is the conservative one: letting a bundle extend the reader's trust set is the one move a reader cannot audit.",
  "kind": {
    "group": "vectors.r5e.io",
    "kind": "Note",
    "version": "v1alpha1",
    "substrate": "resource",
    "naming": {
      "mode": "caller"
    },
    "description": "A one-field resource, so a verifier vector has something harmless to admit.",
    "schema": {
      "required": [
        "body"
      ],
      "properties": {
        "body": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "predicates": []
  },
  "setup": [
    {
      "kind": "core.r5e.io/v1/Endorsement",
      "signAs": "node",
      "spec": {
        "subject": "$key.2",
        "subjectKey": {
          "algorithm": "ed25519",
          "bytes": "$key.2.bytes"
        },
        "role": "probe",
        "kinds": [
          "*"
        ],
        "mayIssue": true,
        "notBefore": "2020-01-01T00:00:00Z",
        "notAfter": "2099-01-01T00:00:00Z"
      }
    },
    {
      "kind": "core.r5e.io/v1/Succession",
      "sign": [
        "node",
        3
      ],
      "spec": {
        "predecessor": "$nodeKey",
        "successor": "$key.3",
        "successorKey": {
          "algorithm": "ed25519",
          "bytes": "$key.3.bytes"
        }
      }
    }
  ],
  "instance": {
    "name": "n1",
    "sign": [
      2
    ],
    "spec": {
      "body": "under authority"
    },
    "authority": [
      "$setup.0.eventRef"
    ]
  },
  "verify": {
    "trust": [
      {
        "key": "$nodeKey"
      }
    ]
  },
  "expect": {
    "outcome": "admitted",
    "verifier": {
      "notChecked": [
        "not trusted unless pinned"
      ]
    }
  }
}
