{
  "note": "§9: a pin admits a chain iff the root actor is the pinned key, **the act's Kind is in the pin's `kinds`**, and the citing event's `ts` is inside the pin's term. A reader who pinned a key for one Kind has not pinned it for another.",
  "kind": {
    "group": "vectors.r5e.io",
    "kind": "Note",
    "version": "v1alpha1",
    "substrate": "resource",
    "naming": {
      "mode": "caller"
    },
    "description": "A one-field resource, so a verifier vector has something harmless to admit.",
    "schema": {
      "required": [
        "body"
      ],
      "properties": {
        "body": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "predicates": []
  },
  "setup": [
    {
      "kind": "core.r5e.io/v1/Endorsement",
      "signAs": "node",
      "spec": {
        "subject": "$key.2",
        "subjectKey": {
          "algorithm": "ed25519",
          "bytes": "$key.2.bytes"
        },
        "role": "probe",
        "kinds": [
          "*"
        ],
        "mayIssue": true,
        "notBefore": "2020-01-01T00:00:00Z",
        "notAfter": "2099-01-01T00:00:00Z"
      }
    }
  ],
  "instance": {
    "name": "n1",
    "sign": [
      2
    ],
    "spec": {
      "body": "under authority"
    },
    "authority": [
      "$setup.0.eventRef"
    ]
  },
  "verify": {
    "trust": [
      {
        "key": "$nodeKey",
        "kinds": [
          "some.other/v1/Kind"
        ]
      }
    ]
  },
  "expect": {
    "outcome": "admitted",
    "verifier": {
      "lines": {
        "endorsements": "0 resolved to a pinned root"
      }
    }
  }
}
