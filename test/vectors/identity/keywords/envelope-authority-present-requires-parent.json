{
  "note": "KS-3: the envelope condition reads the **act**, not the document. An act that exercises authority to issue must name the parent it exercised — otherwise the record would show a delegation with no link to what permitted it. The authority cited is a root Endorsement this key made for itself: §5 requires the cited entry's subject to be the actor, so a vector cannot borrow somebody else's.",
  "kind": {
    "group": "vectors.r5e.io",
    "kind": "Guarded",
    "version": "v1alpha1",
    "substrate": "resource",
    "naming": {
      "mode": "caller"
    },
    "description": "The envelope condition and a nested requires group on one Kind.",
    "schema": {
      "required": [],
      "properties": {
        "parent": {
          "type": "string"
        },
        "self": {
          "type": "string"
        },
        "x": {
          "type": "string"
        },
        "y": {
          "type": "string"
        },
        "z": {
          "type": "string"
        }
      },
      "requires": [
        {
          "when": {
            "envelope": "authority",
            "present": true
          },
          "then": [
            "parent"
          ]
        },
        {
          "when": {
            "envelope": "authority",
            "present": false
          },
          "then": [
            "self"
          ]
        },
        {
          "when": {
            "present": "x"
          },
          "then": [
            [
              "y",
              "z"
            ]
          ]
        }
      ],
      "additionalProperties": false
    },
    "predicates": []
  },
  "instance": {
    "name": "g1",
    "spec": {
      "self": "x"
    },
    "authority": [
      "$setup.0.eventRef"
    ]
  },
  "expect": {
    "outcome": "denied",
    "stage": "validateConstraints",
    "reasonIncludes": "an act exercising authority requires \"parent\""
  },
  "setup": [
    {
      "kind": "core.r5e.io/v1/Endorsement",
      "sign": [
        1
      ],
      "spec": {
        "subject": "$key.1",
        "subjectKey": {
          "algorithm": "ed25519",
          "bytes": "$key.1.bytes"
        },
        "role": "test-root",
        "kinds": [
          "*"
        ],
        "mayIssue": true,
        "notBefore": "2020-01-01T00:00:00Z",
        "notAfter": "2099-01-01T00:00:00Z"
      }
    }
  ]
}
