{
  "note": "§4/KS-4: and with authority cited, the same act is admitted. The authority cited is a root Endorsement this key made for itself: §5 requires the cited entry's subject to be the actor, so a vector cannot borrow somebody else's.",
  "kind": {
    "group": "vectors.r5e.io",
    "kind": "Requiring",
    "version": "v1alpha1",
    "substrate": "event",
    "naming": {
      "mode": "content"
    },
    "description": "A Kind admitted only under cited authority.",
    "schema": {
      "required": [],
      "properties": {
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "predicates": [],
    "requiresAuthority": true
  },
  "instance": {
    "spec": {
      "note": "acting under authority"
    },
    "authority": [
      "$setup.0.eventRef"
    ]
  },
  "expect": {
    "outcome": "admitted"
  },
  "setup": [
    {
      "kind": "core.r5e.io/v1/Endorsement",
      "sign": [
        1
      ],
      "spec": {
        "subject": "$key.1",
        "subjectKey": {
          "algorithm": "ed25519",
          "bytes": "$key.1.bytes"
        },
        "role": "test-root",
        "kinds": [
          "*"
        ],
        "mayIssue": true,
        "notBefore": "2020-01-01T00:00:00Z",
        "notAfter": "2099-01-01T00:00:00Z"
      }
    }
  ]
}
