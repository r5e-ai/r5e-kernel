{
  "note": "§1: distinct keyids are required **except** on a Kind declaring two signatures, where signer 1 and signer 2 may be the same key — a self-issued credential is a real act.",
  "kind": {
    "group": "vectors.r5e.io",
    "kind": "Countersigned",
    "version": "v1alpha1",
    "substrate": "event",
    "naming": {
      "mode": "content"
    },
    "description": "A countersigned act: the subject proves possession by signing too.",
    "schema": {
      "required": [
        "issuer",
        "subject"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "matchesSigner": 1
        },
        "subject": {
          "type": "string",
          "matchesSigner": 2
        }
      },
      "additionalProperties": false
    },
    "predicates": [],
    "signatures": 2
  },
  "instance": {
    "spec": {
      "issuer": "$key.1",
      "subject": "$key.1"
    },
    "sign": [
      1,
      1
    ]
  },
  "expect": {
    "outcome": "admitted",
    "signers": [
      "$key.1",
      "$key.1"
    ]
  }
}
