{
  "note": "§0: the edge is gone from the Revocation's seq onward, so the key that was the successor stops speaking for the predecessor — including for authority it was exercising a moment before.",
  "kind": {
    "group": "vectors.r5e.io",
    "kind": "Note",
    "version": "v1alpha1",
    "substrate": "resource",
    "naming": {
      "mode": "caller"
    },
    "description": "A one-field resource, so an authority vector has something harmless to admit.",
    "schema": {
      "required": [
        "body"
      ],
      "properties": {
        "body": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "predicates": []
  },
  "setup": [
    {
      "kind": "core.r5e.io/v1/Endorsement",
      "sign": [
        1
      ],
      "spec": {
        "subject": "$key.2",
        "subjectKey": {
          "algorithm": "ed25519",
          "bytes": "$key.2.bytes"
        },
        "kinds": [
          "*"
        ],
        "mayIssue": true,
        "notBefore": "2020-01-01T00:00:00Z",
        "notAfter": "2099-01-01T00:00:00Z"
      }
    },
    {
      "kind": "core.r5e.io/v1/Succession",
      "sign": [
        2,
        3
      ],
      "spec": {
        "predecessor": "$key.2",
        "successor": "$key.3",
        "successorKey": {
          "algorithm": "ed25519",
          "bytes": "$key.3.bytes"
        }
      }
    },
    {
      "kind": "core.r5e.io/v1/Revocation",
      "sign": [
        2
      ],
      "spec": {
        "revokes": {
          "$ref": "$setup.1.eventRef"
        }
      }
    }
  ],
  "instance": {
    "name": "a1",
    "sign": [
      3
    ],
    "spec": {
      "body": "under authority"
    },
    "authority": [
      "$setup.0.eventRef"
    ]
  },
  "expect": {
    "outcome": "denied",
    "stage": "resolve",
    "reasonIncludes": "authority subject"
  }
}
