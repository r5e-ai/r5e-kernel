{
  "note": "§0: `matches(target.actor, revoker, R.seq)` — the successor speaks for the predecessor, here as everywhere.",
  "kind": "core.r5e.io/v1/Revocation",
  "setup": [
    {
      "kind": "core.r5e.io/v1/Endorsement",
      "sign": [
        1
      ],
      "spec": {
        "subject": "$key.2",
        "subjectKey": {
          "algorithm": "ed25519",
          "bytes": "$key.2.bytes"
        },
        "kinds": [
          "*"
        ],
        "mayIssue": true,
        "notBefore": "2020-01-01T00:00:00Z",
        "notAfter": "2099-01-01T00:00:00Z"
      }
    },
    {
      "kind": "core.r5e.io/v1/Succession",
      "sign": [
        1,
        3
      ],
      "spec": {
        "predecessor": "$key.1",
        "successor": "$key.3",
        "successorKey": {
          "algorithm": "ed25519",
          "bytes": "$key.3.bytes"
        }
      }
    }
  ],
  "instance": {
    "kind": "core.r5e.io/v1/Revocation",
    "sign": [
      3
    ],
    "spec": {
      "revokes": {
        "$ref": "$setup.0.eventRef"
      }
    }
  },
  "expect": {
    "outcome": "admitted"
  }
}
