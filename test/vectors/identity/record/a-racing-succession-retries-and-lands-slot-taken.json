    "admit": {
      "kind": "core.r5e.io/v1/Succession",
      "sign": [
        1,
        3
      ],
      "spec": {
        "predecessor": "$key.1",
        "successor": "$key.3",
        "successorKey": {
          "algorithm": "ed25519",
          "bytes": "$key.3.bytes"
        }
      }
    }
  },
  "instance": {
    "kind": "core.r5e.io/v1/Succession",
    "sign": [
      1,
      2
    ],
    "spec": {
      "predecessor": "$key.1",
      "successor": "$key.2",
      "successorKey": {
        "algorithm": "ed25519",
        "bytes": "$key.2.bytes"
      }
    }
  },
  "expect": {
    "outcome": "denied",
    "stage": "resolve",
    "reasonIncludes": "succession slot taken",
    "recorded": true
  }
