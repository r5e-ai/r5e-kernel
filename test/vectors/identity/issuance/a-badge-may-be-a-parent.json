{
  "note": "§5/KS-5: `parent` declares an event Kind **list**, so a Badge can be the parent of an Endorsement. One citation, two Kinds it may name.",
  "kind": "core.r5e.io/v1/Endorsement",
  "setup": [
    {
      "kind": "core.r5e.io/v1/Badge",
      "sign": [
        1,
        2
      ],
      "spec": {
        "subject": "$key.2",
        "subjectKey": {
          "algorithm": "ed25519",
          "bytes": "$key.2.bytes"
        },
        "kinds": [
          "*"
        ],
        "mayIssue": true,
        "notBefore": "2020-01-01T00:00:00Z",
        "notAfter": "2099-01-01T00:00:00Z",
        "subjectKind": "agent"
      }
    }
  ],
  "instance": {
    "kind": "core.r5e.io/v1/Endorsement",
    "sign": [
      2
    ],
    "spec": {
      "subject": "$key.3",
      "subjectKey": {
        "algorithm": "ed25519",
        "bytes": "$key.3.bytes"
      },
      "kinds": [
        "*"
      ],
      "mayIssue": true,
      "notBefore": "2020-01-01T00:00:00Z",
      "notAfter": "2099-01-01T00:00:00Z",
      "parent": {
        "$ref": "$setup.0.eventRef"
      }
    },
    "authority": [
      "$setup.0.eventRef"
    ]
  },
  "expect": {
    "outcome": "admitted"
  }
}
