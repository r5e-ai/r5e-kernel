{
  "note": "§7, the manifest half. The instance cites a resource; resolve records the generation it found. Between authorize and record the target is superseded, so the generation the manifest holds is no longer the one on the store. Nothing is appended: the admission re-runs from resolve and the manifest that lands cites the superseding entry. This is what stops a receipt from citing a generation that was already displaced at the seq the receipt was written at — the whole point of capturing the generation rather than only the address.",
  "kinds": [
    {
      "group": "vectors.r5e.io",
      "kind": "Target",
      "version": "v1alpha1",
      "substrate": "resource",
      "naming": {
        "mode": "caller"
      },
      "schema": {
        "required": [],
        "properties": {
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "predicates": []
    }
  ],
  "kind": {
    "group": "vectors.r5e.io",
    "kind": "Cites",
    "version": "v1alpha1",
    "substrate": "resource",
    "naming": {
      "mode": "caller"
    },
    "schema": {
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "type": "ref",
          "ref": {
            "kind": "vectors.r5e.io/v1alpha1/Target"
          }
        }
      },
      "additionalProperties": false
    },
    "predicates": []
  },
  "setup": [
    {
      "kind": "vectors.r5e.io/v1alpha1/Target",
      "name": "t1",
      "spec": {
        "label": "first"
      }
    }
  ],
  "interleave": {
    "before": "record",
    "repeat": 1,
    "kind": "vectors.r5e.io/v1alpha1/Target",
    "admit": {
      "name": "t1",
      "spec": {
        "label": "second"
      }
    }
  },
  "instance": {
    "name": "c",
    "spec": {
      "target": {
        "$ref": "vectors.r5e.io/v1alpha1/Target/t1"
      }
    }
  },
  "expect": {
    "outcome": "admitted",
    "name": "c",
    "recordAttempts": 2,
    "notHalted": true,
    "resolvedRefs": [
      {
        "path": "/target",
        "class": "kind",
        "value": "vectors.r5e.io/v1alpha1/Target/t1",
        "admissionEvent": "$interleaved.0.eventRef",
        "generation": "$interleaved.0.seq"
      }
    ]
  }
}
